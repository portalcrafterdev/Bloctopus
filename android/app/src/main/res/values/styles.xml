<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. The game has one look in both system modes, so the light and night variants are deliberately identical. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window theme once the process has started: this is what sits behind
         the Flutter UI while it initialises, and behind it while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/blocktopus_bg</item>
    </style>
</resources>
